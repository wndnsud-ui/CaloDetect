# Backend only. Keep .env out of Git.
DATABASE_URL=postgresql+psycopg://calodetect:replace_me@localhost:5432/calodetect
FRONTEND_ORIGIN=http://localhost:5173
# Production stays closed until approved consent is configured.
APP_ENV=production
LOCAL_TEST_SIGNUP=false
LOCAL_TEST_IMAGE_ANALYSIS=false
POSTGRES_PASSWORD=replace_me
# Approved: email/password + HttpOnly session cookies.
# Approved minimum age: 18 (age entered in completed years).
AGE_MIN=18
# Leave consent wording unset until approved.
# SERVICE_CONSENT_TEXT=
# MODEL_IMPROVEMENT_CONSENT_TEXT=
COOKIE_SECURE=false
SESSION_HOURS=24
# Google Identity Services: Web client ID + authorized JavaScript origins.
# GOOGLE_CLIENT_ID=
# Sign in with Apple: Services ID + registered HTTPS return URL/domain.
# APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=https://your-domain.example/login
# Shared random secret (at least 32 characters) for short-lived OAuth challenges.
# OAUTH_STATE_SECRET=
# Image storage / retention / recommendation targets: TBD
# Only enable after team approval. Example paths are not a retention policy.
# IMAGE_STORAGE_DIR=.private-uploads
# RECOMMENDATION_ENABLED=true
# RECENT_MEAL_WINDOW=3
