# Backend only. Keep .env out of Git. No policy defaults are authorized yet.
DATABASE_URL=postgresql+psycopg://calodetect:replace_me@localhost:5432/calodetect
FRONTEND_ORIGIN=http://localhost:5173
POSTGRES_PASSWORD=replace_me
# Approved: email/password + HttpOnly session cookies.
# Leave these unset until the team approves age and consent wording.
# AGE_MIN=
# SERVICE_CONSENT_TEXT=
# MODEL_IMPROVEMENT_CONSENT_TEXT=
COOKIE_SECURE=false
SESSION_HOURS=24
