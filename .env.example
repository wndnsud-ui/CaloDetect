# Backend only. Keep .env out of Git.
DATABASE_URL=postgresql+psycopg://calodetect_develop:replace_me@localhost:5432/calodetect_develop
DATABASE_URL_DOCKER=postgresql+psycopg://calodetect_develop:replace_me@db:5432/calodetect_develop
POSTGRES_USER=calodetect_develop
POSTGRES_DB=calodetect_develop
FRONTEND_ORIGIN=http://localhost:5174
# Production stays closed until approved consent is configured.
APP_ENV=production
LOCAL_TEST_SIGNUP=false
LOCAL_TEST_IMAGE_ANALYSIS=false
# Chat meal recording is opt-in; apply the chat migrations before enabling.
CHAT_RECORD_ENABLED=false
# Rewards (CaloPoint·Growth). Required deploy time: signups after it get signup onboarding and the nickname step.
# Unset = no signup onboarding; everyone is treated as a pre-launch member. Point values are dev defaults (TBD).
# REWARD_ONBOARDING_START_AT=2026-10-20T00:00:00+09:00
# Stage B switch: community reactions earn XP instead of points; set community point values to 0 when enabling.
REWARD_COMMUNITY_XP_MODE=false
# Stage C exchange/coupons stay off unless both are set (and OAUTH_STATE_SECRET encrypts coupon codes). Cap value is TBD.
REWARD_EXCHANGE_ENABLED=false
# REWARD_EXCHANGE_GLOBAL_MONTHLY_CAP=
# REWARD_EXCHANGE_MIN_ACCOUNT_DAYS=14
# 리워드몰 v1.3: 콜라보 기획전(실존 브랜드, 내부 시연용)과 전문 코칭 이용권. 기본 꺼짐, 운영 공개 전 별도 승인.
REWARD_COLLAB_DEMO_ENABLED=false
REWARD_COACHING_ENABLED=false
POSTGRES_PASSWORD=replace_me
# Approved: email/password + HttpOnly session cookies.
# Approved minimum age: 18 (age entered in completed years).
AGE_MIN=18
# Leave consent wording unset until approved.
# SERVICE_CONSENT_TEXT=
COOKIE_SECURE=false
SESSION_HOURS=24
# Gmail SMTP password reset (server only; Gmail app password, not account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURITY=starttls
# SMTP_USERNAME=your-account@gmail.com
# SMTP_FROM=your-account@gmail.com
# SMTP_PASSWORD=
# PASSWORD_RESET_SECRET= (random secret of at least 32 characters)
# Public Google Web client ID. Register localhost:5174 and the localhost:8000 callback in Cloud Console.
GOOGLE_CLIENT_ID=426791017551-r50egkaqmso9kctqn1aoucv22pduqb8r.apps.googleusercontent.com
# Optional for the server-side authorization-code flow. GIS login does not need this secret.
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# Sign in with Apple: Services ID + registered HTTPS return URL/domain.
# APPLE_CLIENT_ID=
# APPLE_REDIRECT_URI=https://your-domain.example/login
# Shared random secret (at least 32 characters) for OAuth state and short-lived signup cookies.
# OAUTH_STATE_SECRET=
# Kakao REST API key and server-only Client Secret (never VITE_ variables).
# KAKAO_CLIENT_ID=
# KAKAO_CLIENT_SECRET=
KAKAO_REDIRECT_URI=http://localhost:8000/api/auth/kakao/callback
# Image storage / retention / recommendation targets: TBD
# Only enable after team approval. Example paths are not a retention policy.
# IMAGE_STORAGE_DIR=.private-uploads
# RECOMMENDATION_ENABLED=true
# RECENT_MEAL_WINDOW=3
